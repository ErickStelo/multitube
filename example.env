# =============================================================================
# MultiTube — Variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Nunca commite o arquivo .env (ele deve estar no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------

# Porta em que o servidor HTTP/WebSocket irá escutar.
# Padrão: 3031
PORT=3031

# Caminho completo do arquivo onde o estado das salas (vídeos, mudo, etc.) é
# persistido. Use um caminho absoluto em produção para evitar ambiguidade.
# Padrão: state.json no diretório do projeto
# STATE_FILE=/caminho/absoluto/state.json

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------

# Define o ambiente de execução. Use "production" em produção para ativar
# logs em JSON (uma linha por evento) e desativar o banner colorido no console.
# Valores comuns: development | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# URL do site (Analytics, SEO, sitemap)
# -----------------------------------------------------------------------------
# Em produção (ex.: Render), defina SITE_URL como a URL pública HTTPS do app
# (ex.: https://multitube.onrender.com) para meta OG, canonical, sitemap e robots.txt.
# Padrão em desenvolvimento: http://localhost:PORT
# SITE_URL=https://seudominio.com

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------

# Origens permitidas pelo CORS. Use "*" para permitir qualquer origem (útil em
# desenvolvimento) ou uma URL específica em produção (ex.: https://meudominio.com).
# Padrão: *
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Limpeza de salas (opcional)
# -----------------------------------------------------------------------------
# Para ativar a remoção automática de salas vazias, defina ambas as variáveis
# com valores maiores que zero. Caso contrário, a limpeza fica desativada.

# Intervalo em milissegundos entre cada verificação de salas inativas.
# Ex.: 60000 = a cada 1 minuto
# CLEANUP_INTERVAL_MS=60000

# Tempo em milissegundos sem nenhum cliente conectado na sala para que ela
# seja considerada inativa e removida. Ex.: 1800000 = 30 minutos
# ROOM_IDLE_TIMEOUT_MS=1800000
